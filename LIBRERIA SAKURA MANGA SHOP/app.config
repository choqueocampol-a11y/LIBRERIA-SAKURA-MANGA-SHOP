<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
	<!-- Cadena de conexión a la base de datos Libreria -->
	<add name="ConexionLibreria" 
		 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Libreria;Integrated Security=True;Encrypt=False;TrustServerCertificate=True" 
		 providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
	<!-- Configuración de seguridad y aplicación -->
	<add key="MaxIntentosFallidos" value="3" />
	<add key="TiempoBloqueoMinutos" value="15" />
	<add key="RequiereEncriptacion" value="false" />
  </appSettings>

  <startup>
	<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
